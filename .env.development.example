# ============================================================
#  BFA-Scout — LOCAL DEV environment (Phase 8)
#  Copy to `.env` (the existing dev convention) and fill values.
#  No Spaces / no Docker needed for local dev.
# ============================================================

SECRET_KEY=dev-only-not-secret-change-me
FLASK_ENV=development
BASE_URL=http://127.0.0.1:5057

# Local Postgres (or a dev DO database). No sslmode needed for localhost.
DATABASE_URL=postgresql://bfa:bfa@127.0.0.1:5432/bfa_scout

# Spaces intentionally UNSET in dev — storage.py falls back to
# app/static/photos/<id>.jpg on the local filesystem. Leave these
# commented; setting SPACES_BUCKET would flip storage into Spaces mode.
# SPACES_ENDPOINT=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_KEY=
# SPACES_SECRET=

# First-run admin seed (matches the existing dev convention; the
# startup seeder + scripts/bootstrap_admin.py accept either name pair).
INITIAL_ADMIN_EMAIL=admin@bfa.local
INITIAL_ADMIN_PASSWORD=devadmin
