# Secrets
.env
# Phase 8: production/dev env files are droplet-local — NEVER committed.
# The .example templates ARE committed (placeholder values only).
.env.production
.env.development
.env.*.local

# Phase 8: origin TLS cert/key for nginx (Cloudflare Full-strict).
# Generated on the droplet via openssl; never tracked.
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Uploads
uploads/

# Player photos (user data — not tracked in git)
app/static/photos/*.jpg

# Virtual environments
.venv/
venv/
env/

# IDEs
.idea/
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

bfa_scout_credentials.txt
