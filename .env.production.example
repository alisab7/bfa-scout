# ============================================================
#  BFA-Scout — PRODUCTION environment (Phase 8)
#  Copy to `.env.production` on the droplet and fill real values.
#  `.env.production` is .gitignored — NEVER commit the filled file.
#  docker-compose.prod.yml loads this whole file via `env_file:`.
# ============================================================

# --- Flask core -------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars
FLASK_ENV=production
# Public origin (used by passport PDF base_url + absolute links).
BASE_URL=https://your-temp-domain.example

# --- Database (DO Managed Postgres 15) --------------------------
# Copy the "Connection string" from the DO database console.
# Keep ?sslmode=require — managed PG rejects non-TLS.
DATABASE_URL=postgresql://doadmin:<DB_PASSWORD>@private-bfa-scout-db-do-user-35875835-0.l.db.ondigitalocean.com:25060/bfa_scout?sslmode=require
SPACES_KEY=<your-spaces-access-key-id>
SPACES_SECRET=<your-spaces-secret>


# --- DigitalOcean Spaces (player photos) ------------------------
# storage.py activates Spaces mode IFF SPACES_BUCKET is set. Leave
# SPACES_BUCKET blank to fall back to local-filesystem photos (NOT
# for production — prod MUST use Spaces per the Phase 8 hard rule).
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=bfa-scout-photos
SPACES_KEY=<your-spaces-access-key-id>
SPACES_SECRET=<your-spaces-secret>

# --- Initial admin bootstrap (one-time, idempotent) -------------
# scripts/bootstrap_admin.py AND the app's startup seed both accept
# ADMIN_* (preferred) OR the legacy INITIAL_ADMIN_* names. Set ONE
# pair. Seeding is a no-op once any admin row exists, so leaving
# these in the file after first boot is harmless.
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<generate-strong-password-min-8-chars-with-upper-lower-digit-special>
# Legacy aliases (only needed if you prefer them; pick one pair):
# INITIAL_ADMIN_EMAIL=admin@bfa.bh
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
